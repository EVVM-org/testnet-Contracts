{
  "name": "@evvm/testnet-contracts",
  "version": "3.2.0",
  "type": "module",
  "description": "EVVM Testnet Contracts - Smart contracts and tools for scalable, modular, and cross-chain EVM virtualization",
  "files": [
    "contracts/**/*.sol",
    "interfaces/**/*.sol",
    "library/**/*.sol",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "evvm",
    "ethereum",
    "virtual-machine",
    "solidity",
    "smart-contracts",
    "cross-chain",
    "testnet",
    "evm",
    "blockchain",
    "defi"
  ],
  "author": "EVVM Organization",
  "license": "EVVM-NONCOMMERCIAL-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EVVM-org/Testnet-Contracts.git"
  },
  "homepage": "https://github.com/EVVM-org/Testnet-Contracts#readme",
  "bugs": {
    "url": "https://github.com/EVVM-org/Testnet-Contracts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "publish-package": "bun run copy-files && bun publish && bun run clean",
    "prepare-publish": "bun run copy-files && bun run pack",
    "build": "bun run copy-files",
    "copy-files": "cp -r src/contracts . && cp -r src/interfaces . && cp -r src/library .",
    "clean": "rm -rf contracts interfaces library"
  },
  "peerDependencies": {
    "@openzeppelin/contracts": "^4.9.6"
  },
  "dependencies": {
    "@hyperlane-xyz/core": "^3.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@types/prompts": "^2.4.9",
    "forge-std": "^1.1.2",
    "typescript": "^5.9.3"
  }
}
